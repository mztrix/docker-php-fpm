# Reusable attributes for PHP service configuration
x-php-attributes: &php-attributes
  build:
    context: .                # Specifies the build context (current directory)
    target: base              # Target stage for multistage Docker builds
  volumes:
    - .docker/php.ini:/etc/php85/php.ini                      # Mount custom PHP configuration file
    - .docker/php-fpm.d/www.conf:/etc/php85/php-fpm.d/www.conf # Mount custom PHP-FPM pool configuration
    - fpm-sock:/var/run/php                                    # Volume for PHP-FPM UNIX socket for inter-service communication

# Service definition using the reusable attributes
services:
  php:
    <<: *php-attributes  # Inherits configuration from the defined attributes

# Persistent volumes
volumes:
  fpm-sock:                  # Volume to persist the PHP-FPM socket